{
  "manifest_version": 3,
  "name": "京橙复投Cookie更新",
  "version": "1.1",
  "description": "用于更新京橙复投素材推送的Cookie",
  "permissions": [
    "webRequest",
    "alarms",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://api.m.jd.com/*",
    "https://jcheng.jd.com/*",
    "http://127.0.0.1:8888/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "更新Cookie"
  },
  "icons": {
    "48": "icon48.png"
  }
}
